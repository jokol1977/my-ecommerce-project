# Local development only. Replace both passwords before starting PostgreSQL.
DATABASE_URL=postgresql://janan_app:change_this_local_app_password@localhost:5432/janankadeh?schema=public
DIRECT_URL=postgresql://janan_migrator:change_this_local_migrator_password@localhost:5432/janankadeh?schema=public
POSTGRES_PASSWORD=change_this_local_admin_password
APP_DB_PASSWORD=change_this_local_app_password
MIGRATOR_DB_PASSWORD=change_this_local_migrator_password

# Auth.js email sign-in. Keep real values in .env only.
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
AUTH_URL=http://localhost:3000
SMTP_HOST=mail.example.ir
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_smtp_username
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=JananKadeh <no-reply@example.com>

# Optional in local development. Without Redis, bounded in-memory rate limits are used.
REDIS_URL=
RATE_LIMIT_SECRET=replace_with_a_different_random_secret_of_at_least_32_bytes
TRUSTED_PROXY=none

# Optional order-event SMS via the protected minute-level cron; credentials are never exposed to the browser.
SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ZarinPal payments. Use sandbox outside production; live mode requires HTTPS and NODE_ENV=production.
ZARINPAL_MODE=disabled
ZARINPAL_MERCHANT_ID=replace_with_zarinpal_merchant_uuid

# Production release gates. Keep closed until reviewed seller, tax, returns, refund, and settlement processes are ready.
MARKETPLACE_LIVE_CHECKOUT_ENABLED=false
VENDOR_APPROVAL_ENABLED=false

# Protect the scheduled cleanup endpoint; never reuse AUTH_SECRET.
CRON_SECRET=replace_with_a_different_random_secret_of_at_least_32_bytes
