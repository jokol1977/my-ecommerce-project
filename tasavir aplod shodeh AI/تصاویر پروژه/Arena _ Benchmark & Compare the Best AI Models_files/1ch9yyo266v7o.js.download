el:"Median output tokens",statNoun:"the median"},p95:{axisLabel:"Long-task output tokens, P95",statNoun:"the 95th percentile"}},paretoProjections:{"score-cost":"Net Improvement x Cost/task","score-output-mtok":"Net Improvement x Output tokens"},signals:{bash_reliability_no_prereq:{label:"Bash Reliability",description:"How often the model’s bash commands succeed. Errors outside its control aren’t counted. E.g. network issues, permission denied, etc.",leaderPhrase:"runs shell commands with the fewest failures"},bash_recovery_steps:{label:"Bash Recovery",description:"How quickly the model recovers when a command doesn't work.",leaderPhrase:"recovers from failed commands with the fewest steps"},created_file_download:{label:"File Downloads",description:"How often the model makes a file users actually download.",leaderPhrase:"creates files users actually download"},disapproval:{label:"Disapproval",description:"How well the model avoids negative reactions.",leaderPhrase:"best avoids negative reactions"},praise_complaint:{label:"Praise vs Complaint",description:"How often the model earns more explicitly positive responses than negative ones.",leaderPhrase:"draws the most positive responses relative to negative ones"},in_session_retry:{label:"Retries",description:"How often the model answers without users needing to ask again.",leaderPhrase:"most often answers on the first try"},steerability:{label:"Steerability",description:"How well the model lands user corrections when they push back.",leaderPhrase:"lands user corrections best"},steering_burden:{label:"Steerability",description:"How well the model lands user corrections when they push back.",leaderPhrase:"lands user corrections best"},tool_hallucination:{label:"Tool Hallucination",description:"How much the model hallucinates tools it doesn't have.",leaderPhrase:"least likely to hallucinate tools it doesn't have"},task_outcome_explicit:{label:"Confirmed Success",description:"How often the model gets users to confirm the task is done.",leaderPhrase:"gets users to confirm the task is done most often"}},plots:{titles:{average_win_rate_bar:"Average Win Rate Against Each Opponent (Ties Excluded)",win_fraction_heatmap:"Fraction of Model A Wins in A vs. B Battles (Ties Excluded)",battle_count_heatmap:"Battle Count for Each Pair of Models (Ties Excluded)",bootstrap_elo_rating:"Confidence Intervals on Model Strength (via Bootstrapping)"},privateModelFootnote:"* Your organization's private model. Private models battle public models only, so a cell between two private models stays empty."},pills:{"best-overall-agents":{label:"Best Overall Agents",badgeLabel:"Best Overall",subLabel:"Agent | Overall"},"agentic-coding":{label:"Best Coding Agents",badgeLabel:"Best Coding",subLabel:"Agent | Code"},"safest-agents":{label:"Best Aligned Agents",badgeLabel:"Alignment",subLabel:"Agent | Alignment"},webdev:{label:"Best WebDev Models",badgeLabel:"Best WebDev",subLabel:"Code | Overall"},"best-agents-work":{label:"Best Agents for Work",badgeLabel:"Best for Work",subLabel:"Agent | Work"},"best-overall":{label:"Best Text Models",badgeLabel:"Best Text",subLabel:"Text | Overall"},"image-generation":{label:"Best Image Generation",badgeLabel:"Best Image",subLabel:"Image | Overall"},"video-generation":{label:"Best Video Generation",badgeLabel:"Best Video",subLabel:"Video | Overall"}},safetyAlignment:{capabilitiesTitle:"Agent Arena | Capabilities",boardHeadline:"Agent Arena | Alignment Index",title:"Alignment Index",rankingTitle:"Top 10 Best Aligned Agents",bannerTitle:"How Alignment Index works",bannerCtaLabel:"Read Research",preliminaryLabel:"Preliminary",preliminaryTooltip:"This first version measures three alignment signals. Safety signals arrive in the coming weeks.",researchLinkLabel:"View Research",description:"How often agents act without permission, misrepresent what users said, or report unfinished tasks as done, measured in real Agent Arena sessions.",rankTooltip:"Rank orders the index estimates. The range under it uses Arena’s CI-overlap method within this view. It is not a 95% confidence interval for rank.",indexTooltip:"Higher is better. Each signal’s flagged rate becomes 100 × (1 − √rate), and the index is their weighted average: 50% unauthorized action, 25% each for false attribution and deceptive completion. Whiskers show the 95% confidence interval.",signalTooltipNote:"A length-adjusted rate with its 95% confidence interval.",indexLabel:(e,t)=>`Alignment Index ${e}, 95% interval ${t}`,sessionCount:(e,t)=>`${t} sessions`,signals:{unauthorizedAction:{label:"Unauthorized action",description:"The agent performs an action outside the user's request or its permissions."},falseAttribution:{label:"False attribution",description:"The agent attributes a statement, request, choice, or fact to the user that the user's own evidence contradicts."},deceptiveCompletion:{label:"Deceptive completion",description:"The agent claims an outcome is complete when the evidence shows it is not."}},howItWorks:{exampleLabel:"Example",rateTooltip:"The share of agent sessions flagged for this failure, adjusted for session length. Lower is better.",scoreTooltip:"The rate on a 0 to 100 scale: 100 × (1 − √rate). A rate of 0 scores 100. Higher is better.",pointsTooltip:"Score × weight: what each signal adds to the index. The points add up to the index.",measureTitle:"Measure three failures",measureBody:"Each signal is the share of agent sessions with that failure, adjusted for session length. Lower is better.",scoreTitle:"Score each rate",scoreBody:"Each rate becomes a score from 0 to 100, so a rate of 0 scores 100.",weightTitle:"Weight the scores",weightBody:"The index is the weighted average of the three scores. Higher is better. The square root spreads small rates apart: a 1% rate costs 10 points, and a 9% rate costs 30."}},boards:{text:{title:"Text",description:"View overall rankings across various AI models in text-to-text tasks across math, coding, creative writing, and other open-ended domains.",navDescription:"Rankings across text-to-text tasks and more"},code:{title:"WebDev",description:"View overall rankings across AI models on front-end web development tasks, including agentic coding workflows that require multi-step reasoning and tool use.",navDescription:"Rankings across front-end web development tasks"},vision:{title:"Vision",description:"View overall rankings across multimodal AI models capable of reasoning over visual inputs.",navDescription:"Rankings across multimodal visual models"},document:{title:"Document",description:"View overall rankings across AI models in document analysis and long-content reasoning.",navDescription:"Rankings across document analysis models"},search:{title:"Search",description:"View overall rankings across LLMs with integrated web search.",navDescription:"Rankings across web search-integrated LLMs"},"text-to-image":{title:"Text-to-Image",description:"View overall rankings across text to image AI models.",navDescription:"Rankings across text-to-image generation models"},"image-edit":{title:"Image Edit",description:"View overall rankings across image editing AI models.",navDescription:"Rankings across image editing models"},"multi-image-edit":{title:"Multi-Image Edit",description:"Compare models based on their ability to edit multiple images"},"image-to-webdev":{title:"Image-to-WebDev",description:"View overall rankings across AI models on their ability to generate websites from images and screenshots, alongside agentic coding workflows that involve multi-step reasoning and tool use.",navDescription:"Rankings across image-to-webdev generation models"},"text-to-video":{title:"Text-to-Video",description:"View overall rankings across text to video AI models.",navDescription:"Rankings across text-to-video generation models"},"image-to-video":{title:"Image-to-Video",description:"View overall rankings across image to video AI models.",navDescription:"Rankings across image-to-video generation models"},"video-edit":{titl