 license filter.",netImprovement:"Net Improvement",netImprovementInfo:"How much better or worse a model performs than the average model, with every signal column folded into one score. Positive means above average, negative below; because it's relative, the score shrinks as the average model gets stronger.",netImprovementBar:e=>`Net improvement ${e}`,sessionsInfo:"How many real Agent Mode sessions back this model's metrics.",costInfo:e=>`${e}. Measured from real Agent Mode tasks, not list prices.`,costInfoWindow:(e,t)=>`${e}. Measured from real Agent Mode tasks over the last ${t} days, not list prices.`,tokenInfo:e=>`${e}. Output tokens measured from real Agent Mode tasks.`,tokenInfoWindow:(e,t)=>`${e}. Output tokens measured from real Agent Mode tasks over the last ${t} days.`,priceInfo:"Input / Output price per million tokens. Provider list prices, not the measured Cost/Task.",noValue:"N/A",signalFallback:e=>`How models do on the ${e} behavior.`,up:"Up",down:"Down",preliminary:"Preliminary",signalLeaders:"Signal Leaders",leadsOn:e=>`leads on ${e}`,viewMethodology:"View Methodology",faqTitle:"Frequently asked questions",noSignalData:"No model data for this signal yet.",signalSessions:e=>`${e} Sessions`,viewAllModels:e=>`View all ${e} models`,openSignalDetails:(e,t,r)=>`Open ${e} details for evaluated model at rank ${t} of ${r}`,scrollToModel:(e,t)=>`Scroll to evaluated model at rank ${e} of ${t}`,unknownLab:"Unknown",searchPlaceholder:"Search model, lab, or license",searchLabel:"Search models, labs, and licenses",viewModels:"Models",viewLabs:"Labs",noSearchMatch:"No models match your search.",score:"Score",barLabel:({name:e,value:t,lower:r,upper:o})=>`${e}: ${t}, 95% CI ${r} to ${o}`},agentPareto:{noData:e=>`Data is not available yet for ${e}. It appears here once the next refresh finishes.`,title:"Pareto Frontier",summary:e=>`${e} from real Agent Mode tasks`,reset:"Reset",scroll:"Scroll",controlKey:"Ctrl",zoomIn:"Zoom in",zoomOut:"Zoom out",costPerTask:"Cost/task"