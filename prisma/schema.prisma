generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ProductReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SupportCaseStatus {
  WAITING_FOR_VENDOR
  WAITING_FOR_CUSTOMER
  UNDER_REVIEW
  RESOLVED
}

enum SupportCaseCategory {
  DELIVERY
  ITEM_QUALITY
  MISSING_ITEM
  OTHER
}

enum SupportCaseAuthorRole {
  CUSTOMER
  VENDOR
  ADMIN
}

enum LedgerAccountCode {
  GATEWAY_CLEARING
  UNALLOCATED_ORDER_FUNDS
}

enum LedgerEventType {
  PAYMENT_CAPTURE_VERIFIED
}

enum SmsNotificationType {
  ORDER_PAID
  VENDOR_ORDER_SHIPPED
}

enum SmsNotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  role          UserRole       @default(CUSTOMER)
  status        UserStatus     @default(ACTIVE)
  accounts      Account[]
  sessions      Session[]
  vendorProfile VendorProfile?
  addresses     Address[]
  orders        Order[]
  productReviews ProductReview[]
  supportCases SupportCase[] @relation("SupportCaseCustomer")
  supportCaseMessages SupportCaseMessage[] @relation("SupportCaseMessageAuthor")
  adminAuditEvents AdminAuditEvent[] @relation("AdminAuditActor")
  adminTotpFactor AdminTotpFactor?
  vendorAgreementAcceptances VendorAgreementAcceptance[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailLoginChallenge {
  email      String   @id @db.VarChar(320)
  codeHash   String   @db.Char(64)
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([expiresAt])
}

model AdminTotpFactor {
  userId              String              @id
  encryptedSecret     String              @db.VarChar(512)
  enabledAt           DateTime?
  enrollmentExpiresAt DateTime?
  lastUsedCounter     BigInt?
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes       AdminRecoveryCode[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([enabledAt])
  @@index([enrollmentExpiresAt])
}

model AdminRecoveryCode {
  id        String         @id @default(cuid())
  userId    String
  codeHash  String         @unique @db.Char(64)
  usedAt    DateTime?
  factor    AdminTotpFactor @relation(fields: [userId], references: [userId], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@index([userId, usedAt])
}

model VendorProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  storeName   String
  slug        String       @unique
  description String       @default("") @db.Text
  status      VendorStatus @default(PENDING)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  products    Product[]
  orders      VendorOrder[]
  agreementAcceptances VendorAgreementAcceptance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([status, createdAt])
}

model VendorAgreementAcceptance {
  id               String        @id @default(cuid())
  userId           String
  vendorProfileId  String
  contractVersion  String        @db.VarChar(80)
  documentSha256   String        @db.Char(64)
  acceptedAt       DateTime      @default(now())
  user             User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  vendorProfile    VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)

  @@index([userId, acceptedAt])
  @@index([vendorProfileId, acceptedAt])
  @@index([vendorProfileId, contractVersion, documentSha256], map: "VendorAgreementAcceptance_current_idx")
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId, isActive])
}

model Product {
  id            String        @id @default(cuid())
  vendorId      String
  categoryId    String
  slug          String
  name          String
  description   String        @default("") @db.Text
  brandName     String?       @db.VarChar(120)
  productType   String?       @db.VarChar(120)
  modelCode     String?       @db.VarChar(120)
  sellerSku     String?       @db.VarChar(80)
  publicProductId String?     @db.VarChar(80)
  originCountry String?       @db.VarChar(100)
  packageLengthMm Int?
  packageWidthMm  Int?
  packageHeightMm Int?
  packageWeightGrams Int?
  warrantyDescription String? @db.VarChar(500)
  specificationsText String?  @db.Text
  sourceReference String?     @db.VarChar(2048)
  sellerContentAttestedAt DateTime?
  priceToman    Int
  stockQuantity Int           @default(0)
  status        ProductStatus @default(DRAFT)
  reviewNote    String?       @db.VarChar(500)
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  orderItems    OrderItem[]
  reviews       ProductReview[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([vendorId, slug])
  @@unique([vendorId, sellerSku])
  @@index([status, categoryId, createdAt])
  @@index([status, createdAt, id])
  @@index([status, priceToman, id])
  @@index([vendorId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String   @default("")
  position  Int      @default(0)
  sizeBytes Int      @default(0)
  storageReady Boolean @default(false)
  storageDeleting Boolean @default(false)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductReview {
  id         String              @id @default(cuid())
  productId  String
  customerId String
  rating     Int
  body       String              @db.VarChar(2000)
  status     ProductReviewStatus @default(PENDING)
  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer   User                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([productId, customerId])
  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}

model AdminAuditEvent {
  id          String    @id @default(cuid())
  actorUserId String?
  action      String    @db.VarChar(80)
  targetType  String    @db.VarChar(40)
  targetId    String    @db.VarChar(80)
  createdAt   DateTime  @default(now())
  actor       User?     @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt, id])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  title        String
  recipient    String
  phone        String
  province     String
  city         String
  addressLine  String   @db.Text
  buildingNumber String?
  unit         String?
  postalCode   String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, createdAt])
}

model Order {
  id                    String       @id @default(cuid())
  idempotencyKey        String?      @unique
  requestFingerprint    String?      @db.VarChar(64)
  customerId            String
  status                OrderStatus  @default(PENDING_PAYMENT)
  paymentExpiresAt      DateTime?
  recipient             String
  phone                 String
  province              String
  city                  String
  addressLine           String       @db.Text
  buildingNumber       String?
  unit                  String?
  postalCode            String
  subtotalToman         Int
  shippingFeeToman      Int          @default(0)
  totalToman            Int
  customer              User         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendorOrders          VendorOrder[]
  payments              Payment[]
  ledgerTransfers       LedgerTransfer[]
  smsNotifications      SmsNotification[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([status, paymentExpiresAt])
}

model VendorOrder {
  id              String      @id @default(cuid())
  orderId         String
  vendorId        String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotalToman   Int
  shippingProvider String?     @db.VarChar(80)
  trackingCode     String?     @db.VarChar(80)
  shippedAt        DateTime?
  deliveryConfirmedAt DateTime?
  vendor        VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  supportCases  SupportCase[]
  smsNotifications SmsNotification[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
}

model SupportCase {
  id            String              @id @default(cuid())
  customerId    String
  vendorOrderId String
  category      SupportCaseCategory
  status        SupportCaseStatus   @default(WAITING_FOR_VENDOR)
  customer      User                @relation("SupportCaseCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  vendorOrder   VendorOrder         @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  messages      SupportCaseMessage[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([customerId, updatedAt, id])
  @@index([vendorOrderId, status, updatedAt, id])
  @@index([status, updatedAt, id])
}

model SupportCaseMessage {
  id            String                 @id @default(cuid())
  supportCaseId String
  authorUserId  String
  authorRole    SupportCaseAuthorRole
  body          String                 @db.VarChar(4000)
  supportCase   SupportCase            @relation(fields: [supportCaseId], references: [id], onDelete: Restrict)
  author        User                   @relation("SupportCaseMessageAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  createdAt     DateTime               @default(now())

  @@index([supportCaseId, createdAt, id])
  @@index([authorUserId, createdAt])
}

model OrderItem {
  id               String      @id @default(cuid())
  vendorOrderId    String
  productId        String
  productName      String
  quantity         Int
  unitPriceToman   Int
  vendorOrder      VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([vendorOrderId])
  @@index([productId])
}

model Payment {
  id                      String        @id @default(cuid())
  orderId                 String
  provider                String
  providerReference       String?       @unique
  providerTransactionId   String?       @unique
  amountToman             Int
  status                  PaymentStatus @default(PENDING)
  verificationStartedAt   DateTime?
  verifiedAt              DateTime?
  order                   Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  ledgerTransfers         LedgerTransfer[]

  @@index([orderId, status])
}

model LedgerTransfer {
  id             String            @id @default(cuid())
  eventKey       String            @unique @db.VarChar(120)
  eventType      LedgerEventType
  debitAccount   LedgerAccountCode
  creditAccount  LedgerAccountCode
  amountToman    Int
  orderId        String
  paymentId      String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment        Payment           @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt      DateTime          @default(now())

  @@index([orderId, createdAt, id])
  @@index([paymentId, createdAt])
  @@index([eventType, createdAt, id])
  @@index([debitAccount, createdAt])
  @@index([creditAccount, createdAt])
}

model SmsNotification {
  id             String               @id @default(cuid())
  eventKey       String               @unique @db.VarChar(120)
  eventType      SmsNotificationType
  orderId        String
  vendorOrderId  String?
  status         SmsNotificationStatus @default(PENDING)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime             @default(now())
  lockedAt       DateTime?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  order          Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendorOrder    VendorOrder?         @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, lockedAt])
  @@index([orderId, createdAt, id])
}
