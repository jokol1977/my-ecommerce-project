# Copy to .env.production on the Linux host, then replace every placeholder.
# Generate secrets with: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64url'))"
APP_PORT=3000
AUTH_URL=https://janankadeh.ir
AUTH_SECRET=replace_with_a_random_base64url_secret
RATE_LIMIT_SECRET=replace_with_a_different_random_base64url_secret
CRON_SECRET=replace_with_a_third_random_base64url_secret

# Use URL-safe random passwords so the PostgreSQL and Redis URLs need no escaping.
POSTGRES_PASSWORD=replace_with_a_long_unique_admin_password
APP_DB_PASSWORD=replace_with_a_long_unique_app_password
MIGRATOR_DB_PASSWORD=replace_with_a_long_unique_migrator_password
DATABASE_URL=postgresql://janan_app:replace_with_a_long_unique_app_password@database:5432/janankadeh?schema=public
DIRECT_URL=postgresql://janan_migrator:replace_with_a_long_unique_migrator_password@database:5432/janankadeh?schema=public

REDIS_PASSWORD=replace_with_a_long_unique_redis_password
REDIS_URL=redis://:replace_with_a_long_unique_redis_password@redis:6379/0

# Keep live checkout and seller onboarding closed until their release gates are satisfied.
ZARINPAL_MODE=disabled
ZARINPAL_MERCHANT_ID=replace_with_zarinpal_merchant_uuid
MARKETPLACE_LIVE_CHECKOUT_ENABLED=false
VENDOR_APPROVAL_ENABLED=false

# Optional paid-order and shipment notifications via the protected minute-level cron. Kavenegar is supported.
SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
